# Required: private app password and a separate random signing secret for login cookies.
APP_PASSWORD=change-this-to-a-long-private-password
SESSION_SECRET=replace-with-a-long-random-secret

# Get these from your Pluggy application dashboard.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_INCLUDE_SANDBOX=false

# Local PostgreSQL container settings. Use letters and numbers in POSTGRES_PASSWORD,
# because the compose file builds a database URL from this value.
POSTGRES_DB=finance
POSTGRES_USER=finance
POSTGRES_PASSWORD=replace-with-a-random-alphanumeric-password

# Local HTTP uses false. Set true when serving the app behind HTTPS.
COOKIE_SECURE=false
APP_BIND=127.0.0.1
APP_PORT=8080
